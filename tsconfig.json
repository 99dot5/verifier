{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "lib": [
            "es2022",
            "dom"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@99dot5/round-replay": [
                "./round-replay/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "round-replay/src/**/*.ts"
    ]
}
