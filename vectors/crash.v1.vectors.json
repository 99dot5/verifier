  "auto_cashout_ppm_vectors": {
    "_comment": "Rule-level vectors for the ppm -> tick auto-cashout POLICY (not curve math): reject at or below m(0) = 1_000_000 ppm, reject above MAX_MULTIPLIER_CAP_PPM = 1_000_000_000 ppm, else auto_cashout_tick = crash_tick(ppm). Both boundaries are inclusive on the side named. Two implementations are bound to this table: the sequencer's command-decode path (services/sequencer/src/proto_conversions/crash/v1.rs) and the round verifier's projection rule (clients/round-verifier/src/verify/projection.ts), which must agree or a player's signed auto-cashout target cannot be checked against the transcript the kernel replayed. auto_cashout_tick is null exactly when accepted is false.",
    "vectors": [
      {
        "auto_cashout_ppm": 500000,
        "accepted": false,
        "auto_cashout_tick": null,
        "note": "0.50x -- below the curve floor"
      },
      {
        "auto_cashout_ppm": 1000000,
        "accepted": false,
        "auto_cashout_tick": null,
        "note": "exactly 1.00x = m(0), the inclusive lower REJECT boundary"
      },
      {
        "auto_cashout_ppm": 1000001,
        "accepted": true,
        "auto_cashout_tick": 1,
        "note": "the smallest accepted target: one ppm above m(0)"
      },
      {
        "auto_cashout_ppm": 1500000,
        "accepted": true,
        "auto_cashout_tick": 59,
        "note": "1.50x"
      },
      {
        "auto_cashout_ppm": 2000000,
        "accepted": true,
        "auto_cashout_tick": 100,
        "note": "2.00x -- one doubling, so the tick is DOUBLING_TICKS"
      },
      {
        "auto_cashout_ppm": 10000000,
        "accepted": true,
        "auto_cashout_tick": 333,
        "note": "10x"
      },
      {
        "auto_cashout_ppm": 999999999,
        "accepted": true,
        "auto_cashout_tick": 996,
        "note": "one ppm below the 1000x cap"
      },
      {
        "auto_cashout_ppm": 1000000000,
        "accepted": true,
        "auto_cashout_tick": 996,
        "note": "exactly the 1000x cap, the inclusive upper ACCEPT boundary"
      },
      {
        "auto_cashout_ppm": 1000000001,
        "accepted": false,
        "auto_cashout_tick": null,
        "note": "one ppm above the cap -- unreachable, a guaranteed loss"
      },
      {
        "auto_cashout_ppm": 2000000000,
        "accepted": false,
        "auto_cashout_tick": null,
        "note": "2000x, far above the cap"
      }
    ]
  },
