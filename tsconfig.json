{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "lib": [
            "es2022",
            "dom"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
